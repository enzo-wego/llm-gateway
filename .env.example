# ── service ──────────────────────────────────────────────────────────────────
# Local dev: 127.0.0.1. On the VPS this must be the gateway address of the
# Docker network agent-mem runs on (172.18.0.1 for agent-mem_default) — a
# container cannot reach the host's loopback. Confirm with:
#   docker inspect <worker> --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
LLM_GATEWAY_HOST=127.0.0.1
LLM_GATEWAY_PORT=8750
# Shared secret agent-mem sends as X-API-Key. Required.
LLM_GATEWAY_API_KEY=

# ── claude seat auth ─────────────────────────────────────────────────────────
# Produced by `claude setup-token` — the headless login path. Required on any
# box where nobody has run an interactive `claude /login`. Exporting it in
# ~/.zshrc is NOT enough: systemd does not read shell rc files, so the value
# has to live here.
CLAUDE_CODE_OAUTH_TOKEN=

# ── backends ─────────────────────────────────────────────────────────────────
# claude = subscription seat via the bundled CLI. openrouter = today's behaviour.
LLM_GATEWAY_BACKEND_SUMMARY=claude
LLM_GATEWAY_BACKEND_CHEAP=claude
LLM_GATEWAY_BACKEND_DESCRIBE=claude

# On seat quota exhaustion, degrade to OpenRouter instead of failing.
# The Slack alert fires either way.
LLM_GATEWAY_FALLBACK_ON_QUOTA=true

# ── models ───────────────────────────────────────────────────────────────────
LLM_GATEWAY_MODEL_SUMMARY=claude-sonnet-5
LLM_GATEWAY_MODEL_CHEAP=claude-haiku-4-5
LLM_GATEWAY_EFFORT_SUMMARY=medium
LLM_GATEWAY_EFFORT_CHEAP=low
LLM_GATEWAY_MAX_BUDGET_USD=0.50
LLM_GATEWAY_CLAUDE_TIMEOUT_S=180

# Used when a route's backend is openrouter, and as the quota-fallback target.
# Set these to anthropic/claude-* slugs if a caller needs Claude behaviour
# preserved when the route is pointed at OpenRouter.
LLM_GATEWAY_OR_MODEL_SUMMARY=google/gemini-3.6-flash
LLM_GATEWAY_OR_MODEL_CHEAP=google/gemini-2.5-flash
# /describe has no tier. Defaults to OR_MODEL_SUMMARY, which is the model this
# route has always used — lower it only if describe quality is not worth it.
LLM_GATEWAY_OR_MODEL_DESCRIBE=google/gemini-3.6-flash
# Output ceiling for OpenRouter generation. Raise it for callers whose JSON
# answer is long (a multi-record extraction); the Claude path has no such cap.
LLM_GATEWAY_OR_MAX_TOKENS=4096

# ── openrouter (embeddings, always) ──────────────────────────────────────────
OPENROUTER_API_KEY=
LLM_GATEWAY_EMBED_MODEL=google/gemini-embedding-001
LLM_GATEWAY_EMBED_MAX_BATCH=96

# ── slack alerts ─────────────────────────────────────────────────────────────
# Unset = alerts are logged only. Quota exhaustion is the failure this service
# exists to surface, so set these in prod.
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=
LLM_GATEWAY_ALERT_DEDUPE_S=1800

# NOTE: do NOT set ANTHROPIC_API_KEY here. If present, the Claude CLI silently
# bills the API key instead of the subscription seat. The service unsets it at
# startup, but keeping it out of the environment entirely is safer.
